# Copy this file to .env.local for local development,
# and add the same values in Vercel -> Project -> Settings -> Environment Variables.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # keep secret, server only

# Password to log into /admin
ADMIN_PASSWORD=choose-a-strong-password

# WhatsApp number for all "Order on WhatsApp" buttons.
# Digits only, with country code, no + or spaces. Example for India: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# Optional: powers the "✨ Enhance with AI" upload toggle (auto-crop, light
# color correction, and name/category/material suggestions from the photo).
# Get a key at https://console.anthropic.com. If left blank, uploads still
# get the free automatic fix (orientation, exposure, sharpening, resize) —
# they just skip the AI crop/suggestion step.
ANTHROPIC_API_KEY=

# Optional: powers the "Buy Now" payment flow (Razorpay Payment Links).
# Get these from your Razorpay Dashboard -> Settings -> API Keys.
# Without these, Buy Now shows "payments not set up yet" and WhatsApp
# ordering keeps working as-is.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard -> Settings -> Webhooks -> (your webhook) -> Secret
RAZORPAY_WEBHOOK_SECRET=

# Optional: direct UPI fallback used when Razorpay isn't configured.
UPI_ID=
UPI_PAYEE_NAME=Agavai

# Optional: Instagram handle used for all "Instagram DM" links/buttons (no @).
NEXT_PUBLIC_INSTAGRAM_USERNAME=agavai.in

# Optional: order-status emails to customers (confirmed/packed/shipped/delivered),
# AND the weekly performance email to the founders below — both use the same
# Resend account. Sign up at https://resend.com, verify a sending domain
# (agavai.in) to send to real inboxes, and get an API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@agavai.in

# Weekly performance email only (sent by an external scheduler hitting
# /api/admin/weekly-report?secret=... once a week — see README/admin handbook).
REPORT_RECIPIENTS=founder1@example.com,founder2@example.com
# Any random long string — used so only your scheduler can trigger the report.
CRON_SECRET=
